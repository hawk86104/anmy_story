NODE_ENV=production
PAYLOAD_SECRET=
DATABASE_URL=file:/www/wwwroot/mylife/db/mylife.db
MEDIA_ROOT=/www/wwwroot/mylife/media
# 以下路径、域名和区域均为示例，请按自己的部署环境填写。
MEDIA_STORAGE=cos
COS_APP_ID=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_DOMAIN=
COS_CDN_ORIGIN=
MAX_BACKUP_MB=1024
MAX_BACKUP_EXPANDED_MB=4096
ORIGINALS_ROOT=/www/wwwroot/mylife/media-originals
MEDIA_WORKER_LOCK=/www/wwwroot/mylife/media-worker.lock
WEB_ORIGIN=https://www.example.com
CMS_ORIGIN=https://cms.example.com
MAX_UPLOAD_MB=100
VIDEO_TIMEOUT_SECONDS=600

# 仅用于首次 seed，填入不同邮箱和至少 12 位且不同的密码。
PARENT_EMAIL=
PARENT_PASSWORD=
PARENT_NAME=家长
CHILD_EMAIL=
CHILD_PASSWORD=
CHILD_NAME=小小记录家
