{
  "name": "mylife",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:prepare": "npm run dev:prepare --workspace @mylife/cms",
    "dev:web": "npm run dev --workspace @mylife/web",
    "dev:cms": "npm run dev --workspace @mylife/cms",
    "setup": "node scripts/setup.mjs",
    "seed": "npm run seed --workspace @mylife/cms",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @mylife/cms && npm run test --workspace @mylife/web",
    "build": "npm run build --workspace @mylife/cms && npm run build --workspace @mylife/web",
    "media:worker": "npm run media:worker --workspace @mylife/cms --",
    "restore": "npm run restore --workspace @mylife/cms --"
  },
  "engines": {
    "node": "24.18.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "dompurify": "3.4.17"
  }
}
