PAYLOAD_SECRET=
DATABASE_URL=file:./data/mylife.db
WEB_ORIGIN=http://localhost:3000
CMS_ORIGIN=http://localhost:3001
MAX_UPLOAD_MB=100
MEDIA_ROOT=./media
# 本地开发默认使用本地目录；使用 COS 前先填写自己的云资源配置。
MEDIA_STORAGE=local
COS_APP_ID=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_DOMAIN=
COS_CDN_ORIGIN=
# 完整备份上传与解压上限；代理请求体限制也须同步调整。
MAX_BACKUP_MB=1024
MAX_BACKUP_EXPANDED_MB=4096
# 仅用于读取迁移前的旧原件；新原件存入 media/日期/originals/。
ORIGINALS_ROOT=./media-originals
# 可选：ffmpeg/ffprobe 不在 PATH 时指定可执行文件的绝对路径。
# FFMPEG_PATH=
# FFPROBE_PATH=
VIDEO_TIMEOUT_SECONDS=600
# 可选：仅首次 seed 时提供，密码不写入仓库。
PARENT_EMAIL=
PARENT_PASSWORD=
PARENT_NAME=家长
CHILD_EMAIL=
CHILD_PASSWORD=
CHILD_NAME=小小记录家
